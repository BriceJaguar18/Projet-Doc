{
  "name": "kiosque-pizzas-frouzins",
  "private": true,
  "version": "1.0.0",
  "description": "Écrans Service et Cuisine synchronisés pour le Kiosque à Pizzas de Frouzins",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "demo": "vite --mode demo",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:firebase": "firebase emulators:exec --only auth,firestore --project demo-kiosque \"playwright test -c playwright.firebase.config.ts\"",
    "captures": "CAPTURES=1 playwright test captures"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
